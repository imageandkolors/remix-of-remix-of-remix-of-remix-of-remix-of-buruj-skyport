# Use values from one confirmed Supabase project for both server and browser settings.
# Server runtime values (local development .env and the cPanel Node.js app).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required for user administration, private storage signing, and other privileged operations.
# Keep this server-side only: never use a VITE_ prefix or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public production origin used by server-side Supabase Auth invitation redirects.
SITE_URL=https://your-production-domain.example
# Optional direct Supabase PostgreSQL URL for Drizzle CLI operations only; keep it server-side.
SUPABASE_DB_URL=

# Web Push credentials. Generate once with `npx web-push generate-vapid-keys`.
# Keep VAPID_PRIVATE_KEY server-only; VAPID_PUBLIC_KEY is returned to browsers.
VAPID_SUBJECT=mailto:admin@burujsportsacademy.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Build-time browser values. These must target the same project as the server values above.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public canonical origin used in browser-visible metadata and share links.
VITE_SITE_URL=https://your-production-domain.example

# Optional Google AdSense values, exposed to the browser at build time.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_SIDE=
VITE_ADSENSE_SLOT_INLINE=
