# Supabase project values used by server-side functions.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Build-time browser values. These are public values; never put secrets in VITE_* variables.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://your-production-domain.example

# Server-only key for privileged Supabase operations. Keep this only in the Node app's
# environment settings; do not prefix it with VITE_ or commit a populated .env file.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push credentials. Generate once with `npx web-push generate-vapid-keys`.
# Keep VAPID_PRIVATE_KEY server-only; VAPID_PUBLIC_KEY is returned to browsers.
VAPID_SUBJECT=mailto:admin@burujsportsacademy.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional AI application review integration. Cron secrets are reserved only;
# this repository currently ships no in-app scheduled endpoint.
LOVABLE_API_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Optional Google AdSense values, exposed to the browser at build time.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_SIDE=
VITE_ADSENSE_SLOT_INLINE=
